generator client {
  provider      = "prisma-client-js"
  /// مطلوب لبيئات Linux على Netlify (دوال Next)؛ native للتطوير المحلي
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// مطلوب مع Supabase (pooler): الهجرات تستخدم الرابط المباشر. للمحلي ضع نفس قيمة DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String?     @unique
  passwordHash String
  name         String
  phone        String      @unique
  accountKind  String   @default("RESIDENT")
  createdAt    DateTime    @default(now())
  /// يُعبأ تلقائياً عند غياب مزود البريد؛ أو بعد فتح رابط التحقق
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  /// يُعبأ عند التسجيل أو حفظ رقم جوال صالح (لا مسار OTP في التطبيق).
  phoneVerifiedAt      DateTime?
  /// حقول قديمة لمسار OTP مُزال — تُصفّى لاحقاً إن رُفع مخطّط الإنتاج بدون الحاجة لها.
  phoneOtpCode         String?
  phoneOtpExpires      DateTime?
  /// إظهار الاسم في قائمة سكان المبنى
  visibleInResidents   Boolean   @default(true)

  buildingsCreated Building[] @relation("BuildingCreator")
  memberships      Membership[]
  messages         ChatMessage[]
  announcements    Announcement[]
  maintenanceCreated MaintenanceRequest[] @relation("MaintCreatedBy")
  votesCast        VoteBallot[]
  invitationsSent  InviteToken[] @relation("InviteCreator")
  supervisorVoteOptions VoteOption[] @relation("SupervisorCandidate")
}

model Building {
  id          String   @id @default(cuid())
  name        String
  /// سطر عنوان للعرض (مُجمَّع من العنوان الوطني)
  address     String
  city        String
  region            String?
  district          String?
  streetName        String?
  buildingNumber    String?
  additionalNumber  String?
  postalCode        String?
  shortAddressCode  String?
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  creatorId   String
  creator     User     @relation("BuildingCreator", fields: [creatorId], references: [id])

  units                Unit[]
  votes                Vote[]
  announcements        Announcement[]
  chatMessages         ChatMessage[]
  maintenanceRequests  MaintenanceRequest[]
  inviteTokens         InviteToken[]
  healthScores         BuildingHealthScore[]
}

model Unit {
  id         String   @id @default(cuid())
  buildingId String
  label      String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  memberships          Membership[]
  historyEvents        ApartmentHistoryEvent[]
  maintenancePersonal  MaintenanceRequest[]
  inviteTokens         InviteToken[]

  @@unique([buildingId, label])
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  unitId      String
  kind        String
  isSupervisor Boolean       @default(false)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
}

model InviteToken {
  id          String         @id @default(cuid())
  token       String         @unique
  buildingId  String
  unitId      String
  kind        String
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  createdById String
  building    Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("InviteCreator", fields: [createdById], references: [id])
}

model Vote {
  id                   String   @id @default(cuid())
  buildingId           String
  type                 String
  title                String
  description          String?
  status               String   @default("OPEN")
  endsAt               DateTime
  maintenanceRequestId String?  @unique
  createdAt            DateTime @default(now())
  building             Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  options              VoteOption[]
  ballots              VoteBallot[]
}

model VoteOption {
  id         String @id @default(cuid())
  voteId     String
  label      String
  userId     String?
  vote       Vote              @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user       User?             @relation("SupervisorCandidate", fields: [userId], references: [id])
  ballots    VoteBallot[]
}

model VoteBallot {
  id       String @id @default(cuid())
  voteId   String
  userId   String
  optionId String
  vote     Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option   VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
}

model MaintenanceRequest {
  id            String             @id @default(cuid())
  buildingId    String
  unitId        String?
  scope       String
  title         String
  description   String
  status        String   @default("OPEN")
  aiSummary     String?
  aiSuggestions String?
  /// JSON: [{ "company": "...", "rating": 4.5 }, ...] — ناتج التحليل لربط تصويت المجتمع بخيارات VoteOption.
  aiCompaniesJson String?
  /// شركة الصيانة التي اختارها صاحب الطلب (نطاق شخصي فقط).
  selectedVendor  String?
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  building      Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit          Unit?              @relation(fields: [unitId], references: [id])
  createdBy     User               @relation("MaintCreatedBy", fields: [createdById], references: [id])
  vote          Vote?
  historyEvents ApartmentHistoryEvent[]
}

model ApartmentHistoryEvent {
  id                   String               @id @default(cuid())
  unitId               String
  title                String
  detail               String?
  maintenanceRequestId String?
  createdAt            DateTime             @default(now())
  unit                 Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  maintenanceRequest   MaintenanceRequest?  @relation(fields: [maintenanceRequestId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  buildingId  String
  userId      String
  title       String
  body        String
  createdAt   DateTime @default(now())
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  buildingId String
  userId     String
  body       String
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model BuildingHealthScore {
  id         String   @id @default(cuid())
  buildingId String
  month      String
  score      Int
  summary    String?
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, month])
}
