# نسخ إلى .env (لا ترفع .env إلى Git)
#
# === Supabase (موصى به) ===
# لوحة المشروع → Settings → Database:
# • DATABASE_URL: Connection string، وضع **Transaction** (pooler، المنفذ 6543) — أضف pgbouncer=true إن لم يكن
# • DIRECT_URL: **Direct** أو Session على المنفذ 5432 — لـ prisma migrate والهجرات
#
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres"
#
# === PostgreSQL محلي (Docker) — اختياري ===
# docker compose up -d ثم ضع نفس السلسلة في كلا المتغيرين:
# DATABASE_URL="postgresql://amarati:amarati@localhost:5432/amarati?schema=public"
# DIRECT_URL="postgresql://amarati:amarati@localhost:5432/amarati?schema=public"
#
# === مزوّد آخر ===
# غالباً DIRECT_URL نفس الرابط المباشر؛ DATABASE_URL قد يكون pooler حسب المزوّد

AUTH_SECRET="generate-a-long-random-string-at-least-16-chars"

# بريد (أو أكثر مفصولة بفاصلة) لمراجعة طلبات شركات الصيانة
PLATFORM_ADMIN_EMAILS="admin@example.com"

# رابط الموقع العلني (لروابط الدعوة والتحقق من البريد)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- التحقق من البريد (Resend) — افتراضياً معطّل؛ فعّله بـ REQUIRE_EMAIL_VERIFICATION=true
# 1) أنشئ مفاتيح API: https://resend.com/api-keys
# 2) انسخ هذا الملف إلى `.env` والصق المفتاح بعد re_ (لا ترفع `.env` إلى Git)
# 3) `onboarding@resend.dev` للتجربة فقط؛ لإنتاج حقيقي اربط نطاقك في Resend وغيّر العنوان
# REQUIRE_EMAIL_VERIFICATION=true  ← يفرض رابط التحقق عند التسجيل
RESEND_API_KEY="re_PASTE_YOUR_KEY_HERE"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- نموذج ML (مشروع Colab: RandomForest + توصيات مكة) ---
# الدفتر: https://colab.research.google.com/drive/1BFWwkmam1MXkW5FBLrQR77OiDleyKLMy
# خادم جاهز في المستودع: pip install -r scripts/requirements-ml.txt
#   python scripts/maintenance_ml_server.py
# ضع ملف النموذج المدرَّب (home_failure_model.pkl أو modelMaintenance.joblib) في scripts واستخدم:
#   set MODEL_PATH=C:\path\to\home_failure_model.pkl   (Windows)
# إن لم يوجد ملف، الخادم يُدرّب نموذجاً اصطناعياً مرة واحدة ويحفظه في scripts/home_failure_model.pkl
#
# إرسال POST JSON: { "description": "...", "city": "...", "buildingId": "..." (اختياري) }
# استجابة JSON: { "summary"?, "suggestions"?, "tags"?, "meta"? }
# MAINTENANCE_ML_API_URL="http://localhost:8080/predict"
# MAINTENANCE_ML_API_KEY=""

# Netlify: Site settings → Environment variables
#   - نفس DATABASE_URL (PostgreSQL)
#   - AUTH_SECRET
#   - فعّل النطاق لـ "Builds" و"Functions" (أو الكل) لكل متغير
