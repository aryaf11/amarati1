# لو استخدمت Vercel Postgres من لوحة Vercel (Storage)، تُنشأ تلقائياً متغيرات POSTGRES_* — التطبيق ينسخ POSTGRES_PRISMA_URL أو POSTGRES_URL إلى DATABASE_URL و DIRECT_URL عند الإقلاع إن لم تكن المعايير المعتادة موجودة.

# === Supabase (موصى به) ===
# لوحة المشروع → Settings → Database:
# • DATABASE_URL: Connection string، وضع **Transaction** (pooler، المنفذ 6543) — أضف pgbouncer=true إن لم يكن
# • DIRECT_URL: **Direct** فقط (مضيف db....supabase.co أو ....supabase.co:5432) — لـ prisma migrate
#   ⚠ لا تضع هنا pooler.supabase.com — الهجرات تتعطل (P1002 advisory lock timeout)
#
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres"
#
# === PostgreSQL محلي (Docker) — اختياري ===
# docker compose up -d ثم ضع نفس السلسلة في كلا المتغيرين:
# DATABASE_URL="postgresql://amarati:amarati@localhost:5432/amarati?schema=public"
# DIRECT_URL="postgresql://amarati:amarati@localhost:5432/amarati?schema=public"
#
# === مزوّد آخر ===
# غالباً DIRECT_URL نفس الرابط المباشر؛ DATABASE_URL قد يكون pooler حسب المزوّد

AUTH_SECRET="generate-a-long-random-string-at-least-16-chars"
# على Vercel/Netlify: لا تلف القيمة بعلامتي اقتباس؛ طول السرّ يجب أن يكون 16 محرفاً أو أكثر بعد الإزالة التلقائية للاقتباس الخارجي.

# بريد (أو أكثر مفصولة بفاصلة) لمراجعة طلبات شركات الصيانة
PLATFORM_ADMIN_EMAILS="admin@example.com"

# رابط الموقع العلني (لروابط الدعوة والتحقق من البريد)
# محلياً: http://localhost:3000 — على Vercel: نطاق المشروع (مثل https://amarati-tau.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- التحقق من البريد (Resend) — افتراضياً معطّل؛ فعّله بـ REQUIRE_EMAIL_VERIFICATION=true
# 1) أنشئ مفاتيح API: https://resend.com/api-keys
# 2) انسخ هذا الملف إلى `.env` والصق المفتاح بعد re_ (لا ترفع `.env` إلى Git)
# 3) `onboarding@resend.dev` للتجربة فقط؛ لإنتاج حقيقي اربط نطاقك في Resend وغيّر العنوان
# REQUIRE_EMAIL_VERIFICATION=true  ← يفرض رابط التحقق عند التسجيل
RESEND_API_KEY="re_PASTE_YOUR_KEY_HERE"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- التحقق من الجوال — اختيار قناة الإرسال ---
# المسار الافتراضي «auto»: يجرّب WhatsApp إن كانت مهيأة ثم يسقط إلى Twilio SMS.
# لتثبيت قناة واحدة فقط: OTP_CHANNEL=whatsapp  أو  OTP_CHANNEL=sms
# OTP_CHANNEL=auto

# === WhatsApp Cloud API (Meta) — الموصى به في السعودية، مجاني لأول 1000 محادثة/شهر ===
# خطوات التهيئة (تستغرق ~10 دقائق):
#   1) ادخل https://developers.facebook.com → My Apps → Create App → Business
#   2) Add Product → WhatsApp → Set up
#   3) من API Setup انسخ:
#        • Temporary access token (يصلح للتجربة 24 ساعة) — لاحقاً أنشئ System User
#          من Business Settings → Users → System Users → Generate New Token
#          (Permissions: whatsapp_business_messaging + whatsapp_business_management)
#        • Phone Number ID
#   4) في API Setup → To: أضف رقم جوالك السعودي للاختبار (سيصلك OTP من Meta لتأكيده)
# WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxx"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_API_VERSION="v21.0"
#
# للإنتاج: أنشئ Authentication Template معتمد من Meta عبر:
#   Business Manager → WhatsApp Manager → Message Templates → Create Template
#   Category: Authentication — Body: «رمز التحقق في عَمارتي: {{1}}» — زر «Copy code»
# ثم أضف:
# WHATSAPP_OTP_TEMPLATE_NAME="amarati_otp"
# WHATSAPP_OTP_TEMPLATE_LANG="ar"     # اختياري؛ يُختار من لغة الواجهة افتراضياً

# === Twilio Verify (موصى به) — خدمة OTP مُدارة من Twilio ===
# Twilio يُولّد الرمز ويتحقّق منه، بدون شراء رقم، ويعمل دولياً.
# خطوات التهيئة (~5 دقائق):
#   1) console.twilio.com → Verify → Services → Create new Service
#   2) أدخل اسم الخدمة (مثلاً "Amarati")
#   3) انسخ Verify Service SID (يبدأ بـ VA...)
#   4) من Account Dashboard انسخ Account SID (يبدأ بـ AC...) و Auth Token
#   5) في وضع التجربة: أضف رقم جوالك في Verified Caller IDs
# عند ضبط هذه المتغيّرات الثلاثة، يتجاوز التطبيق توليد الرمز محلياً ويعتمد على Twilio Verify.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Twilio SMS العادي (بديل لـ Verify) — يحتاج شراء رقم ===
# استخدمه إذا أردت إرسال SMS مخصّصة أو لا تريد كلفة Verify لكل تحقّق.
# TWILIO_FROM_NUMBER="+12025550123"        # أو TWILIO_MESSAGING_SERVICE_SID="MGxxxx..."

# === تجاوز التحقق في التطوير ===
# عند ضبط قيمة هنا، أي رمز يطابقها يُقبَل دون الحاجة لإرسال فعلي.
# VERIFICATION_DEV_OTP="123456"

# --- نموذج ML (مشروع Colab: RandomForest + توصيات مكة) ---
# الدفتر: https://colab.research.google.com/drive/1BFWwkmam1MXkW5FBLrQR77OiDleyKLMy
# خادم جاهز في المستودع: pip install -r scripts/requirements-ml.txt
#   python scripts/maintenance_ml_server.py
# ضع ملف النموذج المدرَّب (home_failure_model.pkl أو modelMaintenance.joblib) في scripts واستخدم:
#   set MODEL_PATH=C:\path\to\home_failure_model.pkl   (Windows)
# إن لم يوجد ملف، الخادم يُدرّب نموذجاً اصطناعياً مرة واحدة ويحفظه في scripts/home_failure_model.pkl
#
# إرسال POST JSON: { "description": "...", "city": "...", "buildingId": "..." (اختياري) }
# استجابة JSON: { "summary"?, "suggestions"?, "tags"?, "meta"? }
MAINTENANCE_ML_API_URL="http://localhost:8080/predict"
# MAINTENANCE_ML_API_KEY=""

# Netlify: Site settings → Environment variables
#   - نفس DATABASE_URL (PostgreSQL)
#   - AUTH_SECRET
#   - فعّل النطاق لـ "Builds" و"Functions" (أو الكل) لكل متغير
