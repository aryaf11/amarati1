# نسخ إلى .env وعدّل القيم (لا ترفع .env إلى Git)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string-at-least-16-chars"

# بريد (أو أكثر مفصولة بفاصلة) لمراجعة طلبات شركات الصيانة
PLATFORM_ADMIN_EMAILS="admin@example.com"

# رابط الموقع العلني (لروابط الدعوة)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Netlify / الإنتاج: عيّن DATABASE_URL وAUTH_SECRET في لوحة Netlify → Environment variables.
# SQLite لا يعمل بشكل موثوق على دوال Netlify؛ لإنتاج حقيقي استخدم PostgreSQL (مثلاً Neon) وحدّث DATABASE_URL.
